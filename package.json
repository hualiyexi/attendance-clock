{
  "name": "@hualiyexi/attendance-clock",
  "version": "1.6.0",
  "description": "Phase-aware attendance countdowns for the DeepSeek Harness composer: daily overview, actual clock-out, work hours, overtime, lunch mode, and optional reminders.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hualiyexi/attendance-clock.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "attendance",
    "clock-in",
    "countdown",
    "composer",
    "chip"
  ],
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
