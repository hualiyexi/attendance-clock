{
  "name": "@hualiyexi/dsh-attendance-clock",
  "version": "2.0.1",
  "description": "Phase-aware attendance countdowns with a native click-open panel, host-themed light/dark UI, daily overview, repeat clock-out, work hours, overtime, lunch mode, and reminders.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hualiyexi/dsh-attendance-clock.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "attendance",
    "clock-in",
    "countdown",
    "composer",
    "chip"
  ],
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
